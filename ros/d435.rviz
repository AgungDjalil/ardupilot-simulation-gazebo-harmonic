Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 300
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.3
    - Class: rviz_default_plugins/Axes
      Name: D435 frame
      Enabled: true
      Reference Frame: d435_link
      Length: 0.3
      Radius: 0.02
    - Class: rviz_default_plugins/PointCloud2
      Name: D435 points
      Enabled: false
      Topic:
        Value: /d435/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 0
      Queue Size: 10
    - Class: rviz_default_plugins/Image
      Name: D435 RGB
      Enabled: true
      Topic:
        Value: /d435/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: D435 depth
      Enabled: true
      Topic:
        Value: /d435/depth_image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: false
      Min Value: 0
      Max Value: 10
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: d435_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Distance: 8
      Pitch: 0.5
      Yaw: 3.14
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1400
  Height: 900
