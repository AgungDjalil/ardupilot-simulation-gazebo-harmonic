Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 300
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.3
    - Class: rviz_default_plugins/PointCloud2
      Name: World obstacles (ground truth)
      Enabled: true
      Topic:
        Value: /sim/world_cloud
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Queue Size: 2
    - Class: rviz_default_plugins/Odometry
      Name: Drone (ground truth)
      Enabled: true
      Topic:
        Value: /sim/truth
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Axes
        Axes Length: 0.3
        Axes Radius: 0.02
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Image
      Name: D455 colour
      Enabled: true
      Topic:
        Value: /camera/camera/color/image_raw
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: D455 depth (aligned, mm)
      Enabled: true
      Topic:
        Value: /camera/camera/aligned_depth_to_color/image_raw
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: false
      Min Value: 0
      Max Value: 8000
    - Class: rviz_default_plugins/Image
      Name: D455 infra1 (--infra)
      Enabled: false
      Topic:
        Value: /camera/camera/infra1/image_rect_raw
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: sim_origin
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: sim_truth
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Distance: 10
      Pitch: 0.6
      Yaw: 3.14
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1400
  Height: 900
