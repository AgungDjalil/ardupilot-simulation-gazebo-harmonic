<?xml version="1.0"?>
<model>
  <name>TRUF drone replica: Iris with ArduPilot and RealSense D455</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    ardupilot_gazebo's iris_with_ardupilot (LGPL-3.0) with iris_with_standoffs merged in, so the
    model-level enable_wind applies to the body, plus an Intel RealSense D455 (colour + aligned
    depth, optional infrared pair) mounted as on the real drone, and a ground-truth odometry
    publisher (/model/iris/odometry). Topics: d455/image, d455/depth_image, d455/camera_info,
    d455/infra1/image, d455/infra2/image.
  </description>
  <depend>
    <model><uri>model://iris_with_standoffs</uri></model>
  </depend>
</model>
