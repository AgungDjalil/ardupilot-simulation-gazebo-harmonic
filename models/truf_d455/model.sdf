<?xml version='1.0'?>
<!-- The real drone's replica: Iris with ArduPilot + Intel RealSense D455 mounted as on the real
     drone. The only drone of this simulation; run_gazebo.sh adds it to every world (model name
     "iris"). Built from ardupilot_gazebo's models/iris_with_ardupilot/model.sdf (LGPL-3.0):
     iris_with_standoffs is merged instead of nested (so <enable_wind> reaches the body), its
     "iris_with_standoffs::" name prefixes are dropped, and the camera is added. ArduPilot plugin,
     LiftDrag etc. are unchanged. The iris hovers at ~39% throttle (the real FC: 40%). -->
<sdf version="1.9">
  <model name="truf_d455">
    <!-- Feel the world's <wind> (baylands.sdf, or the wind option of run_gazebo.sh). Applies to this
         model's own links, which is why iris_with_standoffs is merged in below. -->
    <enable_wind>true</enable_wind>
    <!-- merged, so its links (base_link, rotor_N, imu_link) are direct links of this model -->
    <include merge="true">
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!-- Intel RealSense D455 mounted as on the real drone (ego_planner_ws drone_onboard.launch.py
         defaults cam_y/cam_z/cam_roll/cam_pitch: 2 cm above the FC, pitched 22.9 deg down, rolled
         -2.5 deg), except forward: the real camera is 9 cm in front of the FC, but the iris body
         reaches 14.5 cm (collision mesh) and a camera inside it saw nothing (depth -inf), so here it is
         15 cm forward. The Pi's camera_mount TF must match: ~/drone/run_onboard.sh in sim mode passes
         cam_x:=0.15 (keep both alike). sim_camera reads this pose for the IMU rotation.
         The link is the D455's camera_link (x forward, y left, z up); the colour/depth camera sits at its
         origin, the infrared pair 95 mm apart around it. -->
    <link name="d455_link">
      <pose>0.15 0 0.02 -0.0436332 0.3996804 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-4</izz>
        </inertia>
      </inertial>
      <!-- D455 housing: 124 x 26 x 29 mm, behind the lenses (front face at x = 0): with the cameras
           inside it, the depth camera saw only the inside of the box (-inf everywhere). -->
      <visual name="housing">
        <pose>-0.0135 0 0 0 0 0</pose>
        <geometry><box><size>0.026 0.124 0.029</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <!-- Colour + depth from one sensor: aligned depth, identical stamps (as the driver's
           aligned_depth_to_color). 640x480 at 15 Hz = the Pi's camera profile (fps 15); HFOV 90 deg
           = the D455 colour camera (90 x 65 deg). Topics d455/{image,depth_image,camera_info}.
           Exact depth here; sim_camera adds the D455's noise, holes and range limits. -->
      <sensor name="d455" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>d455</topic>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <camera name="color">
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>300</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>12</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
      <!-- infra:begin (kept only with the infrared option of run_gazebo.sh) -->
      <!-- Infrared stereo pair, 848x480 (the D455's optimal depth resolution), HFOV 87 deg, 95 mm
           baseline, left = infra1. Mono, no projector dots. Topics d455/infra1/image,
           d455/infra2/image (+ camera_info). -->
      <sensor name="infra1" type="camera">
        <pose>0 0.0475 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>d455/infra1/image</topic>
        <gz_frame_id>camera_infra1_optical_frame</gz_frame_id>
        <camera name="infra1">
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
      </sensor>
      <sensor name="infra2" type="camera">
        <pose>0 -0.0475 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>d455/infra2/image</topic>
        <gz_frame_id>camera_infra2_optical_frame</gz_frame_id>
        <camera name="infra2">
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
      </sensor>
      <!-- infra:end -->
    </link>
    <joint name="d455_joint" type="fixed">
      <parent>base_link</parent>
      <child>d455_link</child>
    </joint>

    <!-- Ground truth for sim_camera (/sim/truth): the body pose in the world. 30 Hz: the
         camera pose is looked up per image at up to ~1 s render delay. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/iris/odometry</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

    <!--
      visual markers for debugging
      - blade root    - teal
      - blade tip     - orange
      - blade cp      - yellow
      - blade forward - red
      - blade upward  - blue
    -->
