<?xml version="1.0"?>
<model>
  <name>Baylands Park</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Wrapper around Open Robotics' "Baylands" model on Gazebo Fuel (version 3, CC BY 4.0,
    https://app.gazebosim.org/OpenRobotics/fuel/models/Baylands). The meshes and textures are
    loaded from Fuel; only the tree material changes: the original uses an Ogre 1 material script
    (OakTree/Branch) that Gazebo Harmonic's Ogre 2 renderer can't use, so the trees were black.
    Here they get a PBR material with the same Branch.png texture.
  </description>
</model>
