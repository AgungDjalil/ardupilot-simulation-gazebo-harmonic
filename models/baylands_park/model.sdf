<?xml version="1.0"?>
<!-- See model.config. Same links and pose as the Fuel model, tree material replaced. -->
<sdf version="1.9">
  <model name="baylands_park">
    <pose>0 0 -1.3 0 0 0</pose>
    <static>true</static>
    <!-- baylands_01/02: trees (leaves with an alpha texture), baylands_03: ground, paths, water -->
    <link name="body">
      <visual name="visual">
        <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/baylands_01.DAE</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/Textures/Branch.png</albedo_map>
            <roughness>0.9</roughness>
            <metalness>0</metalness>
          </metal></pbr>
          <double_sided>true</double_sided>
        </material>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/baylands_01.DAE</uri></mesh></geometry>
      </collision>
    </link>
    <link name="body2">
      <visual name="visual">
        <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/baylands_02.DAE</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/Textures/Branch.png</albedo_map>
            <roughness>0.9</roughness>
            <metalness>0</metalness>
          </metal></pbr>
          <double_sided>true</double_sided>
        </material>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/baylands_02.DAE</uri></mesh></geometry>
      </collision>
    </link>
    <link name="body3">
      <visual name="visual">
        <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/baylands_03.DAE</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Baylands/3/files/media/baylands_03.DAE</uri></mesh></geometry>
      </collision>
    </link>
  </model>
</sdf>
