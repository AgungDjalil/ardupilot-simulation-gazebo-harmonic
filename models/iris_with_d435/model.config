<?xml version="1.0"?>
<model>
  <name>Iris with ArduPilot and RealSense D435</name>
  <version>1.1</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    ardupilot_gazebo's iris_with_ardupilot (LGPL-3.0) with iris_with_standoffs merged in, so the
    model-level enable_wind applies to the body, plus a forward-facing Intel RealSense D435 RGB-D
    camera on the front of the body. Camera topics: d435/image, d435/depth_image, d435/points,
    d435/camera_info.
  </description>
  <depend>
    <model><uri>model://iris_with_standoffs</uri></model>
    <model><uri>model://realsense_d435</uri></model>
  </depend>
</model>
