<?xml version="1.0"?>
<model>
  <name>Iris with ArduPilot and RealSense D435</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    iris_with_ardupilot (ardupilot_gazebo) with a forward-facing Intel RealSense D435 RGB-D camera
    on the front of the body. Camera topics: d435/image, d435/depth_image, d435/points,
    d435/camera_info.
  </description>
  <depend>
    <model><uri>model://iris_with_ardupilot</uri></model>
    <model><uri>model://realsense_d435</uri></model>
  </depend>
</model>
