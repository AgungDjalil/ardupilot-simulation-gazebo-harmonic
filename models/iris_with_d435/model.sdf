<?xml version="1.0"?>
<sdf version="1.9">
  <model name="iris_with_d435">
    <!-- merge: the ArduPilot plugin's link/joint names (iris_with_standoffs::...) stay valid -->
    <include merge="true">
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <!-- Front of the body (it ends at x = 0.099 m), looking straight ahead. -->
    <include>
      <uri>model://realsense_d435</uri>
      <name>d435</name>
      <pose>0.11 0 0 0 0 0</pose>
    </include>
    <joint name="d435_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>d435::link</child>
    </joint>
  </model>
</sdf>
