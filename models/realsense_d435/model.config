<?xml version='1.0'?>
<model>
  <name>Intel RealSense D435</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
    <name>Cole Biesemeyer</name>
    <email>cole@openrobotics.org</email>
  </author>

  <description>
    Intel RealSense D435 (RGB-D camera, 640x480 @ 30 Hz, depth 0.1-10 m).
    Based on https://app.gazebosim.org/bmchale/fuel/models/Intel%20RealSense%20D435 (CC BY 4.0).
    Changes: mesh rotated 90 deg so the lenses face +x like the sensor (in the original the lenses
    face -y), sensor moved to the lens face, topic set to "d435", update rate 30 Hz.
  </description>
</model>
