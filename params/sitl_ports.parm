# Port MAVLink tambahan, selalu dimuat oleh run_sitl.sh (lihat README bagian 6).

# SERIAL6 = TCP 5766 (--serial6=tcp:6), khusus Mission Planner / MAVProxy.
SERIAL6_PROTOCOL 2

# Stream data di SERIAL2 (TCP 5763, MAVROS). MAVROS tidak meminta stream sendiri, jadi tanpa ini
# /mavros/local_position/*, /mavros/imu/* dst. kosong. MAV3 = port MAVLink ke-3 (SERIAL0, 1, 2).
MAV3_RAW_SENS    10
MAV3_EXT_STAT    2
MAV3_RC_CHAN     5
MAV3_POSITION    20
MAV3_EXTRA1      20
MAV3_EXTRA2      10
MAV3_EXTRA3      2
